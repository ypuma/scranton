# Copy to .env (git-ignored). Scranton loads ./.env at startup; variables that are
# already set in your shell win over the file.
# Precedence overall: command-line flags > environment > scranton.config.json > defaults.

# ---- Models per agent ---------------------------------------------------------------
# Unset provider/model = Automatic: first signed-in supported account in this order:
# Claude, ChatGPT, Gemini, Antigravity (pinned model refs in src/core/agent/model.js).
# Set both provider and exact model ID to override; no fuzzy names or thinking suffixes.
# Example: SCRANTON_DWIGHT_PROVIDER=openai and SCRANTON_DWIGHT_MODEL=gpt-5.3-codex
# Thinking: off | minimal | low | medium | high | xhigh | max
#SCRANTON_MICHAEL_PROVIDER=
#SCRANTON_MICHAEL_MODEL=
#SCRANTON_MICHAEL_THINKING=
#SCRANTON_DWIGHT_PROVIDER=
#SCRANTON_DWIGHT_MODEL=
#SCRANTON_DWIGHT_THINKING=
#SCRANTON_ANGELA_PROVIDER=
#SCRANTON_ANGELA_MODEL=
#SCRANTON_ANGELA_THINKING=
# Oscar/Hank and custom gates use the same SCRANTON_<ROLE>_* variables.
# Custom compatible providers: `scranton provider add <id> --base-url URL --api API
# --models MODEL` (HTTP is allowed only on loopback, e.g. a local Ollama endpoint).
# Then set the role's provider ID and exact model ID together.

# ---- Provider credentials -----------------------------------------------------------
# Use `scranton login claude|chatgpt|antigravity` for OAuth, or
# `scranton login gemini` / `scranton login <provider> --api-key` for keys.
# In a source checkout use `node bin/scranton.js` instead of `scranton`.
# Keys are read through hidden input or stdin, never command-line arguments.
# `scranton accounts` inspects status without refresh; logout removes stored credentials.
# Stored credentials win over environment keys; environment keys remain after logout.
# Antigravity is unofficial Google OAuth; Gemini API keys remain a separate account.
# No guarantee of model entitlement or free quota. LLM calls and credentials stay on
# the host even in Docker mode; the container runs tools only, with no inference broker.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=
# Own credential store directory (private app data, not an encrypted OS keychain).
# Default: dev.scranton.desktop/credentials under the platform app-data directory.
#SCRANTON_CREDENTIALS_DIR=
# One-time import source only: defaults to ~/.pi/agent. Existing Scranton entries win.
# Pi users may need to sign in again after Scranton refreshes imported tokens.
#PI_CODING_AGENT_DIR=

# ---- Scranton settings --------------------------------------------------------------
# Failed test cycles in a row before the circuit breaker trips (default 3)
#SCRANTON_MAX_FAILED_CYCLES=3
# Per-agent timeout in minutes (default 20)
#SCRANTON_AGENT_TIMEOUT_MIN=20
# Where the agents work / where the mailboxes live
#SCRANTON_WORKSPACE=./workspace
#SCRANTON_HIVE=./hive
# Short absolute shadow-repository/worktree root; Windows default:
# %LOCALAPPDATA%\Scranton\iso. Leave commented for the default, not an active empty value.
#SCRANTON_ISOLATION_ROOT=
# Windows native sandbox helper override: existing absolute executable path.
# No automatic install or host fallback if the helper is unavailable.
#SCRANTON_SANDBOX_HELPER=C:\Scranton\scranton-sandbox-helper.exe

# ---- Durable workflows --------------------------------------------------------------
# Unset = local SQLite at <hive>/dbos.sqlite. DBOS SDK loads lazily for Postgres only.
# DBOS_SYSTEM_DATABASE_URL takes precedence over the DBOS_DATABASE_URL alias.
# DATABASE_URL is deliberately ignored. Never commit database credentials.
#DBOS_SYSTEM_DATABASE_URL=
#DBOS_DATABASE_URL=

# ---- Deterministic test/demo provider ------------------------------------------------
# Both are required to enable scripted execution via the environment; a scenario alone
# does not enable it. No real model calls. Prefer `scranton demo` for an explicit demo.
#SCRANTON_FAKE_MODE=1
#SCRANTON_FAKE_SCENARIO=happy

# ---- Pipeline host completion bridge ------------------------------------------------
# Completion deadline in milliseconds (default/max 600000; minimum 1).
#SCRANTON_PIPELINE_COMPLETE_TIMEOUT_MS=600000
