{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-notifications",
  "description": "Only native notifications for the loopback dashboard. No filesystem, shell, window or application commands.",
  "local": false,
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*", "http://localhost:*"] },
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
