{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-window-controls",
  "description": "Only minimize, toggle maximize, close, maximized-state query and native dragging for the main loopback dashboard's integrated title bar.",
  "local": false,
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*", "http://localhost:*"] },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging"
  ]
}
