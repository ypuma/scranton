{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-updates",
  "description": "Scranton update commands and status notifications for the main loopback dashboard.",
  "local": false,
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "allow-update-status",
    "allow-update-check",
    "allow-update-download",
    "allow-update-set-settings",
    "allow-update-install",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
