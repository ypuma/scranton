{
  "schema": 1,
  "models": {
    "planner": {"provider": "openai_compatible", "model": "local-model", "base_url": "http://127.0.0.1:1234/v1", "api_key_env": "LOCAL_MODEL_API_KEY", "structured_output": "json_text"},
    "implementer": {"provider": "openai_compatible", "model": "local-model", "base_url": "http://127.0.0.1:1234/v1", "api_key_env": "LOCAL_MODEL_API_KEY", "structured_output": "json_text"},
    "reviewer": {"provider": "openai_compatible", "model": "local-model", "base_url": "http://127.0.0.1:1234/v1", "api_key_env": "LOCAL_MODEL_API_KEY", "structured_output": "json_text"}
  },
  "sandbox": {"mode": "host"},
