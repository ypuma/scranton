{
  "name": "project-scranton",
  "version": "0.5.0",
  "description": "Multi-agent harness with Scranton's own durable agent runtime, deterministic tools and isolated execution.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "scranton": "bin/scranton.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node bin/scranton.js",
    "demo": "node bin/scranton.js demo",
    "dashboard": "node bin/scranton.js dashboard",
    "visualize": "node bin/scranton.js visualize",
    "app:prepare": "node scripts/prepare-desktop.mjs",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:icon": "node scripts/generate-desktop-icon.mjs && tauri icon src-tauri/icons/source.png",
    "test:packaging": "node --test \"test/packaging/*.test.js\""
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
